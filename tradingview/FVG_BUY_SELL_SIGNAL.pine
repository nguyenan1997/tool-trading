// Inspired by / derived from "Ranked FVG Imbalance Zones" by Zeiierman.
// Licensed under Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International
// https://creativecommons.org/licenses/by-nc-sa/4.0/  © Zeiierman
//
// ============================================================================
//  BẢN GỌN — DỄ NHÌN + LỌC CHẤT LƯỢNG + THỐNG KÊ
//   • Tín hiệu BUY/SELL khi giá hồi về vùng FVG (tuỳ chọn xác nhận khi nến đóng).
//   • Bộ lọc: sức mạnh FVG, cùng chiều EMA, chỉ FVG tươi.
//   • Xác nhận điểm vào: EMA cross (độ dài tuỳ chỉnh) hoặc nến đảo chiều (engulfing, pin bar).
//   • SL sau khối FVG; TP tới biên gần của khối FVG phe đối diện gần nhất.
//   • Chỉ báo khi R:R >= ngưỡng (mặc định 1:1).
//   • Panel: tín hiệu mới + thống kê TP/SL/Winrate/R/Expectancy/PF.
// ============================================================================
//@version=6
indicator("Ranked FVG Signals — Clean", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================ INPUTS ============================
gZ = "1) Vùng FVG"
maxStored  = input.int(80, "Số FVG lưu nội bộ", minval = 10, maxval = 400, group = gZ)
maxZones   = input.int(5, "Chỉ hiển thị N vùng", minval = 1, maxval = 40, group = gZ)
sortDisplay = input.string("Newest", "Sắp xếp vùng hiển thị", options = ["Newest", "Top quality"], group = gZ)
focusATR   = input.float(0.0, "Chỉ hiện vùng trong N×ATR quanh giá (0 = tắt)", minval = 0.0, step = 0.5, group = gZ)
hideTested = input.bool(false, "Ẩn vùng đã bị chạm (chỉ hiện FVG tươi)", group = gZ)
showBoxes  = input.bool(true, "Hiện khối FVG", group = gZ)
showText   = input.bool(false, "Hiện chữ sức mạnh trên khối", group = gZ)
minSizeATR = input.float(0.3, "Lọc FVG nhỏ hơn N×ATR", minval = 0.0, step = 0.1, group = gZ)
volLength   = input.int(20, "Volume MA", group = gZ)
trendLength = input.int(50, "Trend EMA", group = gZ)

gS = "2) Tín hiệu"
useSignals = input.bool(true, "Bật tín hiệu Buy/Sell", group = gS)
waitBars   = input.int(1, "Chờ N nến sau khi tạo FVG", minval = 0, group = gS)
minRR      = input.float(1.0, "R:R tối thiểu", minval = 0.0, step = 0.1, group = gS)
slBufATR   = input.float(0.1, "Buffer SL (×ATR)", minval = 0.0, step = 0.05, group = gS)
requireOpp = input.bool(true, "Bắt buộc có FVG đối diện làm TP", group = gS)
fallbackRR = input.float(2.0, "TP dự phòng (R) khi không có FVG đối diện", minval = 0.1, step = 0.1, group = gS)
onceZone   = input.bool(true, "Mỗi FVG chỉ 1 tín hiệu", group = gS)
confirmClose = input.bool(true, "Chỉ xác nhận khi NẾN ĐÓNG (chống repaint)", group = gS)
minStrength  = input.int(0, "Sức mạnh FVG tối thiểu (0-100, 0=tắt)", minval = 0, maxval = 100, group = gS)
trendFilter  = input.bool(false, "Chỉ lấy FVG cùng chiều EMA", group = gS)
onlyFresh    = input.bool(false, "Chỉ lấy FVG chưa bị chạm (tươi)", group = gS)
entryConfirm = input.string("EMA cross", "Điểm vào quyết định bởi (chọn 1)", options = ["EMA cross", "Reversal candle"], group = gS)
emaLen       = input.int(9, "EMA độ dài (khi chọn EMA cross)", minval = 2, maxval = 100, group = gS)

gV = "3) Hiển thị tín hiệu"
maxSetups = input.int(3, "Giữ N setup gần nhất", minval = 1, maxval = 10, group = gV)
drawSetup = input.bool(true, "Vẽ đường Entry/SL/TP", group = gV)
showSetupInfo = input.bool(false, "Hiện nhãn Entry/SL/TP/R:R trên chart", group = gV)
showResult = input.bool(true, "Hiện nhãn TP / SL khi lệnh kết thúc", group = gV)
showPanel = input.bool(true, "Hiện bảng thông tin", group = gV)

gC = "4) Màu & Alert"
bullColor = input.color(color.rgb(26, 216, 194, 40), "Bullish", inline = "c", group = gC)
bearColor = input.color(color.rgb(216, 26, 102, 40), "Bearish", inline = "c", group = gC)
alertBuy  = input.bool(true, "Alert Buy", group = gC)
alertSell = input.bool(true, "Alert Sell", group = gC)

// ============================ HELPERS ============================
volMA    = ta.sma(volume, volLength)
trendEMA = ta.ema(close, trendLength)
atr      = ta.atr(14)
minTick  = syminfo.mintick
barMs    = timeframe.in_seconds(timeframe.period) * 1000

// Xác nhận điểm vào
emaE         = ta.ema(close, emaLen)
emaBuyCross  = ta.crossover(close, emaE)
emaSellCross = ta.crossunder(close, emaE)
bodyRange    = math.max(high - low, minTick)
bullRev = (close > open and open <= close[1] and close >= open[1]) or ((math.min(open, close) - low) >= 0.6 * bodyRange)
bearRev = (close < open and open >= close[1] and close <= open[1]) or ((high - math.max(open, close)) >= 0.6 * bodyRange)

// ============================ TYPES ============================
type FVG
    float top
    float bottom
    int   direction      // +1 bull, -1 bear
    int   bornBar
    float zsize
    float mitigation
    float volScore
    float trendScore
    float qualityScore
    int   bullStrength
    int   bearStrength
    bool  signaled
    int   firstTouch
    box   body

type Setup
    int   dir
    int   sigBar
    float entry
    float sl
    float tp
    float rr
    bool  done
    line  eLine
    line  sLine
    line  tLine
    label lbl

var array<FVG>   fvgs   = array.new<FVG>()
var array<Setup> setups = array.new<Setup>()

var int   lastDir   = 0
var float lastEntry = na
var float lastSL    = na
var float lastTP    = na
var float lastRR    = na

var int   statSig  = 0
var int   statTp   = 0
var int   statSl   = 0
var float statR    = 0.0
var float statWin  = 0.0
var float statLoss = 0.0

// Chỉ giữ 1 nhãn TP/SL cho lệnh gần nhất
var label resultLbl    = na
var bool  hasResultLbl = false

// ============================ DETECT NEW FVG ============================
gapUp   = low > high[2]
gapDown = high < low[2]

if (gapUp or gapDown) and not na(atr) and atr > 0
    float top    = gapUp ? low : low[2]
    float bottom = gapUp ? high[2] : high
    int   dir    = gapUp ? 1 : -1
    float zsize  = top - bottom

    if zsize >= minSizeATR * atr
        float volScore   = volMA != 0 ? volume / volMA : 1.0
        float trendScore = ((dir == 1 and close > trendEMA) or (dir == -1 and close < trendEMA)) ? 1.0 : 0.0

        float gapS    = math.min(zsize / atr, 2.0) / 2.0 * 40
        float volS    = math.min(volScore, 2.0) / 2.0 * 30
        float trendS  = trendScore * 20
        float candleS = math.abs(close - open) / math.max(high - low, minTick) * 10
        int   sc     = int(math.max(math.min(gapS + volS + trendS + candleS, 100), 0))

        int bullStr = dir == 1 ? sc : 100 - sc
        int bearStr = dir == -1 ? sc : 100 - sc
        float quality = zsize * 100 + volScore * 10 + trendScore * 20

        box body = box.new(time[2], top, time + barMs * 5, bottom, xloc = xloc.bar_time, bgcolor = color.new(color.gray, 100), border_color = color.new(color.gray, 100))

        fvgs.push(FVG.new(top, bottom, dir, bar_index, zsize, 0.0, volScore, trendScore, quality, bullStr, bearStr, false, -1, body))

// ============================ UPDATE (mitigation) ============================
if fvgs.size() > 0
    for i = fvgs.size() - 1 to 0
        FVG f = fvgs.get(i)
        int age = bar_index - f.bornBar
        bool touched = f.direction == 1 ? low <= f.top : high >= f.bottom

        if touched and age > 0
            if f.firstTouch < 0
                f.firstTouch := bar_index
            float fillDist = f.direction == 1 ? f.top - low : high - f.bottom
            float zoneSize = math.max(f.top - f.bottom, minTick)
            f.mitigation := math.min(math.max(fillDist / zoneSize, 0), 1)

        f.qualityScore := f.zsize * 100 + f.volScore * 10 + f.trendScore * 20 - f.mitigation * 50 - age * 0.1
        box.set_right(f.body, time + barMs * 8)

        if f.mitigation >= 1
            box.delete(f.body)
            fvgs.remove(i)
        else
            fvgs.set(i, f)

// ============================ LIMIT + RANK ============================
while fvgs.size() > maxStored
    FVG removed = fvgs.pop()
    box.delete(removed.body)

if fvgs.size() > 0
    if sortDisplay == "Newest"
        fvgs.sort(order.descending, sort_field = "bornBar")
    else
        fvgs.sort(order.descending, sort_field = "qualityScore")

// ============================ DISPLAY ZONES (chỉ Top N) ============================
if fvgs.size() > 0
    for i = 0 to fvgs.size() - 1
        FVG f = fvgs.get(i)
        bool near   = focusATR <= 0 or math.abs(close - math.avg(f.top, f.bottom)) <= focusATR * atr
        bool isTop  = i < maxZones and near and (not hideTested or f.firstTouch < 0)
        color zc    = f.direction == 1 ? bullColor : bearColor

        if showBoxes and isTop
            box.set_bgcolor(f.body, color.new(zc, 65))
            box.set_border_color(f.body, color.new(zc, 0))
            box.set_border_width(f.body, 1)
            box.set_text(f.body, showText ? (f.direction == 1 ? "Bull " + str.tostring(f.bullStrength) + "%" : "Bear " + str.tostring(f.bearStrength) + "%") : "")
            box.set_text_color(f.body, chart.fg_color)
            box.set_text_halign(f.body, text.align_right)
            box.set_text_size(f.body, size.small)
        else
            box.set_bgcolor(f.body, color.new(color.gray, 100))
            box.set_border_color(f.body, color.new(color.gray, 100))
            box.set_text(f.body, "")

// ============================ SIGNALS ============================
buySignal  = false
sellSignal = false

if useSignals and fvgs.size() > 0 and (not confirmClose or barstate.isconfirmed)
    for i = 0 to fvgs.size() - 1
        FVG f = fvgs.get(i)
        int age = bar_index - f.bornBar

        if age < waitBars
            continue
        if onceZone and f.signaled
            continue

        bool touched = f.direction == 1 ? low <= f.top : high >= f.bottom
        if not touched
            continue

        // ---- Bộ lọc chất lượng ----
        int ownStrength = f.direction == 1 ? f.bullStrength : f.bearStrength
        if minStrength > 0 and ownStrength < minStrength
            continue
        if trendFilter and not ((f.direction == 1 and close > trendEMA) or (f.direction == -1 and close < trendEMA))
            continue
        if onlyFresh and f.firstTouch != bar_index
            continue

        // ---- Điểm vào quyết định bởi EMA hoặc mô hình nến (chọn 1) ----
        bool confBuy  = entryConfirm == "EMA cross" ? emaBuyCross : bullRev
        bool confSell = entryConfirm == "EMA cross" ? emaSellCross : bearRev
        if not (f.direction == 1 ? confBuy : confSell)
            continue

        float entry = f.direction == 1 ? f.top : f.bottom
        float sl    = f.direction == 1 ? f.bottom - slBufATR * atr : f.top + slBufATR * atr
        float risk  = math.abs(entry - sl)
        if risk <= 0
            continue

        // TP = biên gần của khối FVG đối diện gần nhất
        float tp = na
        for j = 0 to fvgs.size() - 1
            FVG o = fvgs.get(j)
            if o.direction == -f.direction
                if f.direction == 1
                    if o.bottom > entry
                        tp := na(tp) ? o.bottom : math.min(tp, o.bottom)
                else
                    if o.top < entry
                        tp := na(tp) ? o.top : math.max(tp, o.top)

        if na(tp)
            if requireOpp
                continue
            tp := f.direction == 1 ? entry + fallbackRR * risk : entry - fallbackRR * risk

        float reward = math.abs(tp - entry)
        float rr = reward / risk
        if rr < minRR
            continue

        f.signaled := true
        fvgs.set(i, f)

        if f.direction == 1
            buySignal := true
        else
            sellSignal := true

        lastDir := f.direction
        lastEntry := entry
        lastSL := sl
        lastTP := tp
        lastRR := rr
        statSig += 1

        // ---- Vẽ setup: chỉ đường Entry / SL / TP + nhãn ----
        if drawSetup
            int x2 = bar_index + 15

            line eLine = line.new(bar_index, entry, x2, entry, xloc = xloc.bar_index, color = color.new(color.gray, 0), style = line.style_dashed, width = 1)
            line sLine = line.new(bar_index, sl, x2, sl, xloc = xloc.bar_index, color = color.new(#d81a66, 0), style = line.style_solid, width = 2)
            line tLine = line.new(bar_index, tp, x2, tp, xloc = xloc.bar_index, color = color.new(#1ad8c2, 0), style = line.style_solid, width = 2)

            string txt = (f.direction == 1 ? "BUY" : "SELL") + "\n" + "Entry " + str.tostring(entry, format.mintick) + "\n" + "SL " + str.tostring(sl, format.mintick) + "\n" + "TP " + str.tostring(tp, format.mintick) + "\n" + "R:R " + str.tostring(rr, "#.##")
            label lbl = label.new(x2, f.direction == 1 ? tp : sl, text = showSetupInfo ? txt : "", style = showSetupInfo ? label.style_label_left : label.style_none, color = color.new(f.direction == 1 ? #1ad8c2 : #d81a66, 20), textcolor = color.white, size = size.small)

            setups.push(Setup.new(f.direction, bar_index, entry, sl, tp, rr, false, eLine, sLine, tLine, lbl))

            // Giữ tối đa maxSetups setup ĐÃ kết thúc (không cắt setup đang mở để còn đếm thống kê)
            while setups.size() > maxSetups
                int doneIdx = -1
                for k = 0 to setups.size() - 1
                    Setup s2 = setups.get(k)
                    if s2.done
                        doneIdx := k
                        break
                if doneIdx < 0
                    break
                Setup gone = setups.get(doneIdx)
                line.delete(gone.eLine)
                line.delete(gone.sLine)
                line.delete(gone.tLine)
                label.delete(gone.lbl)
                setups.remove(doneIdx)

            // Bắt đầu lệnh mới -> xoá nhãn TP/SL của lệnh cũ
            if hasResultLbl
                label.delete(resultLbl)
                hasResultLbl := false

// ============================ KIỂM TRA TP / SL ============================
if setups.size() > 0 and (not confirmClose or barstate.isconfirmed)
    for i = 0 to setups.size() - 1
        Setup st = setups.get(i)
        if st.done or bar_index <= st.sigBar
            continue

        bool hitSl = st.dir == 1 ? low <= st.sl : high >= st.sl
        bool hitTp = st.dir == 1 ? high >= st.tp : low <= st.tp

        if hitSl or hitTp
            st.done := true
            setups.set(i, st)
            bool isSl = hitSl
            if isSl
                statSl += 1
                statLoss += 1.0
                statR -= 1.0
            else
                statTp += 1
                statWin += st.rr
                statR += st.rr
            if showResult
                if hasResultLbl
                    label.delete(resultLbl)
                float px = isSl ? st.sl : st.tp
                resultLbl := label.new(bar_index, px, text = isSl ? "SL" : "TP", style = label.style_label_left, color = color.new(isSl ? #d81a66 : #1ad8c2, 0), textcolor = color.white, size = size.small)
                hasResultLbl := true
        else
            // kéo dài đường tới nến hiện tại khi lệnh còn mở
            line.set_x2(st.eLine, bar_index)
            line.set_x2(st.sLine, bar_index)
            line.set_x2(st.tLine, bar_index)

// ============================ PANEL ============================
var table panel = table.new(position.top_right, 2, 13, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1, bgcolor = color.new(color.black, 55))

if showPanel
    int nb = 0
    int ns = 0
    if fvgs.size() > 0
        for i = 0 to fvgs.size() - 1
            FVG f = fvgs.get(i)
            if f.direction == 1
                nb += 1
            else
                ns += 1

    color dirCol = lastDir == 1 ? color.new(#1ad8c2, 30) : lastDir == -1 ? color.new(#d81a66, 30) : color.new(color.gray, 60)

    table.cell(panel, 0, 0, "FVG SIGNALS", text_color = color.white, bgcolor = color.new(color.blue, 40), text_size = size.small)
    table.cell(panel, 1, 0, "R:R ≥ " + str.tostring(minRR, "#.##"), text_color = color.white, bgcolor = color.new(color.blue, 40), text_size = size.small)
    table.cell(panel, 0, 1, "Vùng đang lưu", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 1, "B " + str.tostring(nb) + " / S " + str.tostring(ns), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 2, "Tín hiệu mới", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 2, lastDir == 1 ? "BUY" : lastDir == -1 ? "SELL" : "—", text_color = color.white, bgcolor = dirCol, text_size = size.small)
    table.cell(panel, 0, 3, "Entry", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 3, na(lastEntry) ? "—" : str.tostring(lastEntry, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 4, "SL", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 4, na(lastSL) ? "—" : str.tostring(lastSL, format.mintick), text_color = color.new(#d81a66, 0), text_size = size.small)
    table.cell(panel, 0, 5, "TP", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 5, na(lastTP) ? "—" : str.tostring(lastTP, format.mintick), text_color = color.new(#1ad8c2, 0), text_size = size.small)
    table.cell(panel, 0, 6, "R:R", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 6, na(lastRR) ? "—" : str.tostring(lastRR, "#.##"), text_color = color.white, text_size = size.small)

    // ---- Thống kê ----
    int resolved = statTp + statSl
    float winrate = resolved > 0 ? statTp * 100.0 / resolved : 0.0
    float expectancy = resolved > 0 ? statR / resolved : 0.0
    string pfTxt = statLoss > 0 ? str.tostring(statWin / statLoss, "#.##") : (statWin > 0 ? "∞" : "—")
    color rCol = statR >= 0 ? color.new(#1ad8c2, 0) : color.new(#d81a66, 0)

    table.cell(panel, 0, 7, "Tổng tín hiệu", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 7, str.tostring(statSig), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 8, "TP / SL", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 8, str.tostring(statTp) + " / " + str.tostring(statSl), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 9, "Winrate", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 9, str.tostring(winrate, "#.#") + "%", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 10, "Tổng R", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 10, str.tostring(statR, "#.##") + "R", text_color = rCol, text_size = size.small)
    table.cell(panel, 0, 11, "Expectancy", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 11, str.tostring(expectancy, "#.##") + "R", text_color = rCol, text_size = size.small)
    table.cell(panel, 0, 12, "Profit Factor", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 12, pfTxt, text_color = color.white, text_size = size.small)

// ============================ PLOT / ALERTS ============================
plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color.new(#1ad8c2, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.new(#d81a66, 0), text = "SELL", textcolor = color.white, size = size.small)

alertcondition(alertBuy  and buySignal,  "FVG Buy Signal",  "Giá hồi về FVG tăng, R:R đạt yêu cầu")
alertcondition(alertSell and sellSignal, "FVG Sell Signal", "Giá hồi về FVG giảm, R:R đạt yêu cầu")
