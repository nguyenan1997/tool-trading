//@version=5
// ============================================================================
//  ICT — Killzone → Sweep → Displacement/CHoCH → FVG
//  MÔ PHỎNG KHỚP LIMIT THẬT (giống bot strategies/ict.py / EA ICTBot.mq5):
//    - Phát hiện setup tại nến CHoCH.
//    - Đặt LIMIT tại entry (OTE của FVG), hết hạn sau `pendMin` phút.
//    - Khi giá hồi tới entry -> ĐÁNH DẤU NẾN KHỚP + VẼ NGAY Entry/SL/TP
//      và KÉO DÀI các đường này mỗi nến cho tới khi chạm TP/SL.
//    - Chốt một phần 50% @1R (giống bot mới) -> đánh dấu "TP1".
//  Tham số mặc định đã khớp bản tối ưu: bias h4ema, KZ London(7-11)+NY(12-16),
//  disp 0.5xATR, entry OTE 0.62.
//  Giờ theo BROKER (đặt `brokerOff` = offset broker; LiteFinance +3 hè / +2 đông).
//  Khuyến nghị khung M5.
// ============================================================================
indicator("ICT KZ-Sweep-FVG (LIMIT fill)", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
grpT = "Thời gian (giờ broker)"
brokerOff = input.int(3, "Broker = UTC + (giờ)", -12, 14, group=grpT)
asiaStart = input.int(0,  "Vùng Á - giờ bắt đầu", 0, 23, group=grpT)
asiaEnd   = input.int(6,  "Vùng Á - giờ kết thúc", 0, 23, group=grpT)
kz1s      = input.int(7,  "Killzone 1 - bắt đầu (London)", 0, 23, group=grpT)
kz1e      = input.int(11, "Killzone 1 - kết thúc", 0, 23, group=grpT)
kz2s      = input.int(12, "Killzone 2 - bắt đầu (NY; 0,0 = tắt)", 0, 23, group=grpT)
kz2e      = input.int(16, "Killzone 2 - kết thúc", 0, 23, group=grpT)

grpB = "Bias khung lớn"
biasMode = input.string("h4ema", "Bias", options=["prevday", "h4ema", "none"], group=grpB)
biasEma  = input.int(50, "EMA H4 (khi bias = h4ema)", 5, 400, group=grpB)

grpS = "Cấu trúc"
swingK     = input.int(2, "Swing K (fractal)", 1, 10, group=grpS)
minSweep   = input.float(0.3, "Độ sâu quét (x ATR)", 0.0, 5.0, 0.05, group=grpS)
chochWait  = input.int(36, "Chờ CHoCH tối đa (nến)", 1, 200, group=grpS)
dispATR    = input.float(0.5, "Displacement (x ATR)", 0.0, 5.0, 0.05, group=grpS)
zoneLB     = input.int(12, "Tìm FVG trong (nến)", 2, 100, group=grpS)
minFvgATR  = input.float(0.3, "Lọc FVG size >= k x ATR", 0.0, 5.0, 0.05, group=grpS)
requireFVG = input.bool(true, "Bắt buộc FVG", group=grpS)

grpR = "Vào / Thoát"
entryFrac = input.float(0.62, "Vào tại (0=mép, 0.5=CE, ~0.62=OTE)", 0.0, 1.0, 0.05, group=grpR)
slBufATR  = input.float(0.2, "SL buffer (x ATR)", 0.0, 5.0, 0.05, group=grpR)
minRATR   = input.float(0.0, "R tối thiểu (x ATR)", 0.0, 10.0, 0.1, group=grpR)
maxRATR   = input.float(6.0, "R tối đa (x ATR)", 0.1, 50.0, 0.1, group=grpR)
tpMode    = input.string("DOL", "Chế độ TP", options=["DOL", "R"], group=grpR)
tpR       = input.float(3.0, "TP (x R) khi chế độ R", 0.5, 20.0, 0.5, group=grpR)
tpMinR    = input.float(0.0, "TP DOL tối thiểu (x R)", 0.0, 10.0, 0.25, group=grpR)
pendMin   = input.int(120, "Lệnh LIMIT hết hạn sau (phút)", 5, 1440, group=grpR)
partialFrac = input.float(0.5, "Chốt một phần khi +1R (0 = tắt)", 0.0, 1.0, 0.05, group=grpR)
partialAtR  = input.float(1.0, "Ngưỡng chốt một phần (x R)", 0.1, 10.0, 0.1, group=grpR)

grpD = "Hiển thị"
showTrades = input.bool(true, "Vẽ ENTRY/SL/TP khi khớp + WIN/LOSS", group=grpD)
showStats  = input.bool(true, "Bảng thống kê WIN/LOSS", group=grpD)
showAsia   = input.bool(true, "Vẽ biên vùng Á", group=grpD)
showPDPD   = input.bool(true, "Vẽ PDH/PDL", group=grpD)

// ───────────────────────────── Cơ bản ─────────────────────────────
atr      = ta.atr(14)
bms      = time + brokerOff * 3600000
bh       = int((bms / 3600000) % 24)
bday     = int(bms / 86400000)
inAsia   = bh >= asiaStart and bh <= asiaEnd
asiaDone = bh > asiaEnd
inKZ     = (bh >= kz1s and bh < kz1e) or (bh >= kz2s and bh < kz2e)
expireBars = math.max(1, int(math.round(pendMin * 60 / timeframe.in_seconds())))

// ─────────────────────── Tích lũy theo ngày ───────────────────────
var float dayHi = na
var float dayLo = na
var float dayOpen = na
var float pdh = na
var float pdl = na
var float pdOpen = na
var float pdClose = na
var float aHi = na
var float aLo = na

newDay = ta.change(bday) != 0
if newDay
    pdh     := dayHi
    pdl     := dayLo
    pdOpen  := dayOpen
    pdClose := close[1]
    dayHi   := high
    dayLo   := low
    dayOpen := open
    aHi     := na
    aLo     := na
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low), low)

if inAsia
    aHi := na(aHi) ? high : math.max(aHi, high)
    aLo := na(aLo) ? low  : math.min(aLo, low)

// ───────────────────────────── Bias ─────────────────────────────
htfEma = request.security(syminfo.tickerid, "240", ta.ema(close, biasEma)[1], barmerge.gaps_off, barmerge.lookahead_off)
int bias = 0
if biasMode == "prevday"
    bias := na(pdOpen) or na(pdClose) ? 0 : (pdClose > pdOpen ? 1 : pdClose < pdOpen ? -1 : 0)
else if biasMode == "h4ema"
    bias := na(htfEma) ? 0 : (close > htfEma ? 1 : close < htfEma ? -1 : 0)
else
    bias := 0

// ───────────────────────── Swing fractal ─────────────────────────
ph = ta.pivothigh(high, swingK, swingK)
pl = ta.pivotlow(low, swingK, swingK)
var float lastSH = na
var float lastSL = na
if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl

// ───────────────────── Tiện ích FVG & TP ─────────────────────
f_fvgBull(lb) =>
    float zl = na
    float zh = na
    for o = 0 to lb
        if low[o] > high[o + 2] and low[o] < close
            float size = low[o] - high[o + 2]
            if minFvgATR <= 0 or size >= minFvgATR * atr
                zl := high[o + 2]
                zh := low[o]
                break
    [zl, zh]

f_fvgBear(lb) =>
    float zl = na
    float zh = na
    for o = 0 to lb
        if high[o] < low[o + 2] and high[o] > close
            float size = low[o + 2] - high[o]
            if minFvgATR <= 0 or size >= minFvgATR * atr
                zl := high[o]
                zh := low[o + 2]
                break
    [zl, zh]

f_tp(isBuy, entry, R) =>
    float res = na
    if tpMode == "DOL"
        float bestD = na
        lv = array.from(pdh, pdl, aHi, aLo, lastSH, lastSL)
        for i = 0 to array.size(lv) - 1
            float x = array.get(lv, i)
            if not na(x)
                float dist = isBuy ? x - entry : entry - x
                if dist >= tpMinR * R and (na(bestD) or dist < bestD)
                    bestD := dist
                    res   := x
    if na(res)
        res := isBuy ? entry + tpR * R : entry - tpR * R
    res

f_sweptLow(need) =>
    bool hit = false
    if asiaDone and not na(aLo) and low < aLo - need and close > aLo
        hit := true
    if not na(pdl) and low < pdl - need and close > pdl
        hit := true
    if not na(lastSL) and low < lastSL - need and close > lastSL
        hit := true
    hit

f_sweptHigh(need) =>
    bool hit = false
    if asiaDone and not na(aHi) and high > aHi + need and close < aHi
        hit := true
    if not na(pdh) and high > pdh + need and close < pdh
        hit := true
    if not na(lastSH) and high > lastSH + need and close < lastSH
        hit := true
    hit

drawFill(isBuy, x, e, sl, tp) =>
    txt = (isBuy ? "BUY ENTRY" : "SELL ENTRY") + "\nE " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick)
    label.new(x, isBuy ? low - atr * 0.6 : high + atr * 0.6, txt,
              style = isBuy ? label.style_label_up : label.style_label_down,
              color = isBuy ? color.new(color.teal, 0) : color.new(color.maroon, 0),
              textcolor=color.white, size=size.small)

drawExit(win, x, price) =>
    label.new(x, price, win ? "TP" : "SL",
              style = win ? label.style_label_down : label.style_label_up,
              color = win ? color.new(color.green, 0) : color.new(color.red, 0),
              textcolor=color.white, size=size.tiny)

// ───────────────────────── Trạng thái ─────────────────────────
var bool actB = false
var bool actS = false
var bool doneB = false
var bool doneS = false
var float sweepLow = na
var float sweepHigh = na
var float refHigh = na
var float refLow = na
var int startB = na
var int startS = na

// BUY: pending + position + 3 đường
var bool bHavePend = false
var float bPE = na
var float bPSL = na
var float bPTP = na
var int bPB = na
var int bPX = na
var bool bInPos = false
var bool bPartDone = false
var float bE = na
var float bSL = na
var float bTP = na
var int bFB = na
var line bLE = na
var line bLSL = na
var line bLTP = na

// SELL
var bool sHavePend = false
var float sPE = na
var float sPSL = na
var float sPTP = na
var int sPB = na
var int sPX = na
var bool sInPos = false
var bool sPartDone = false
var float sE = na
var float sSL = na
var float sTP = na
var int sFB = na
var line sLE = na
var line sLSL = na
var line sLTP = na

var int nWin = 0
var int nLoss = 0
var int nBE = 0
var int nSet = 0

if newDay
    actB := false
    actS := false
    doneB := false
    doneS := false
    bPartDone := false
    sPartDone := false
    sweepLow := na
    sweepHigh := na
    refHigh := na
    refLow := na
    startB := na
    startS := na

// ───────────────────── QUẢN LÝ LỆNH (chạy trước phát hiện) ─────────────────────
if barstate.isconfirmed
    // ===== BUY =====
    if bInPos
        if not na(bLE)
            line.set_x2(bLE, bar_index)
        if not na(bLSL)
            line.set_x2(bLSL, bar_index)
        if not na(bLTP)
            line.set_x2(bLTP, bar_index)
        if partialFrac > 0 and not bPartDone and high >= bE + partialAtR * (bE - bSL)
            bPartDone := true
            label.new(bar_index, high, "TP1 " + str.tostring(partialFrac * 100, "#") + "%",
                      style=label.style_label_down, color=color.new(color.green, 0),
                      textcolor=color.white, size=size.tiny)
        if low <= bSL
            drawExit(false, bar_index, bSL)
            if bPartDone
                if partialFrac > 0.5
                    nWin += 1
                else if partialFrac < 0.5
                    nLoss += 1
                else
                    nBE += 1
            else
                nLoss += 1
            bInPos := false
        else if high >= bTP
            drawExit(true, bar_index, bTP)
            nWin += 1
            bInPos := false
    else if bHavePend
        if bar_index > bPX
            bHavePend := false
        else if low <= bPE
            bE := bPE
            bSL := bPSL
            bTP := bPTP
            bFB := bar_index
            bInPos := true
            bPartDone := false
            bHavePend := false
            bLE  := line.new(bar_index, bE,  bar_index + 1, bE,  color=color.new(color.blue, 0),  width=1)
            bLSL := line.new(bar_index, bSL, bar_index + 1, bSL, color=color.new(color.red, 0),   width=1, style=line.style_dashed)
            bLTP := line.new(bar_index, bTP, bar_index + 1, bTP, color=color.new(color.green, 0), width=1, style=line.style_dashed)
            drawFill(true, bar_index, bE, bSL, bTP)
            alert("ICT BUY FILL | Entry " + str.tostring(bE, format.mintick) + " | SL " + str.tostring(bSL, format.mintick) + " | TP " + str.tostring(bTP, format.mintick), alert.freq_once_per_bar_close)
            if low <= bSL
                drawExit(false, bar_index, bSL)
                nLoss += 1
                bInPos := false
            else if high >= bTP
                drawExit(true, bar_index, bTP)
                nWin += 1
                bInPos := false

    // ===== SELL =====
    if sInPos
        if not na(sLE)
            line.set_x2(sLE, bar_index)
        if not na(sLSL)
            line.set_x2(sLSL, bar_index)
        if not na(sLTP)
            line.set_x2(sLTP, bar_index)
        if partialFrac > 0 and not sPartDone and low <= sE - partialAtR * (sSL - sE)
            sPartDone := true
            label.new(bar_index, low, "TP1 " + str.tostring(partialFrac * 100, "#") + "%",
                      style=label.style_label_up, color=color.new(color.green, 0),
                      textcolor=color.white, size=size.tiny)
        if high >= sSL
            drawExit(false, bar_index, sSL)
            if sPartDone
                if partialFrac > 0.5
                    nWin += 1
                else if partialFrac < 0.5
                    nLoss += 1
                else
                    nBE += 1
            else
                nLoss += 1
            sInPos := false
        else if low <= sTP
            drawExit(true, bar_index, sTP)
            nWin += 1
            sInPos := false
    else if sHavePend
        if bar_index > sPX
            sHavePend := false
        else if high >= sPE
            sE := sPE
            sSL := sPSL
            sTP := sPTP
            sFB := bar_index
            sInPos := true
            sPartDone := false
            sHavePend := false
            sLE  := line.new(bar_index, sE,  bar_index + 1, sE,  color=color.new(color.blue, 0),  width=1)
            sLSL := line.new(bar_index, sSL, bar_index + 1, sSL, color=color.new(color.red, 0),   width=1, style=line.style_dashed)
            sLTP := line.new(bar_index, sTP, bar_index + 1, sTP, color=color.new(color.green, 0), width=1, style=line.style_dashed)
            drawFill(false, bar_index, sE, sSL, sTP)
            alert("ICT SELL FILL | Entry " + str.tostring(sE, format.mintick) + " | SL " + str.tostring(sSL, format.mintick) + " | TP " + str.tostring(sTP, format.mintick), alert.freq_once_per_bar_close)
            if high >= sSL
                drawExit(false, bar_index, sSL)
                nLoss += 1
                sInPos := false
            else if low <= sTP
                drawExit(true, bar_index, sTP)
                nWin += 1
                sInPos := false

// ───────────────────── PHÁT HIỆN SETUP (nến đóng, cần inKZ) ─────────────────────
if barstate.isconfirmed and inKZ and not na(atr) and atr > 0
    need = minSweep * atr

    // ---------- BUY ----------
    if (biasMode == "none" or bias > 0) and not doneB
        if actB
            if bar_index - startB > chochWait
                actB := false
            else if close > refHigh and (close - open) >= dispATR * atr
                [zl, zh] = f_fvgBull(zoneLB)
                okFvg = not na(zl) and zh > zl
                if (requireFVG and okFvg) or (not requireFVG)
                    entry = okFvg ? zh - entryFrac * (zh - zl) : close
                    sl    = math.min(sweepLow, okFvg ? zl : sweepLow) - slBufATR * atr
                    R     = entry - sl
                    if R > 0 and entry < close and R >= minRATR * atr and R <= maxRATR * atr
                        doneB := true
                        actB  := false
                        nSet  += 1
                        bHavePend := true
                        bPE := entry
                        bPSL := sl
                        bPTP := f_tp(true, entry, R)
                        bPB := bar_index
                        bPX := bar_index + expireBars
                        alert("ICT BUY setup | Entry " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(f_tp(true, entry, R), format.mintick), alert.freq_once_per_bar_close)
        if not actB and not doneB
            if f_sweptLow(need)
                actB     := true
                sweepLow := low
                refHigh  := lastSH
                startB   := bar_index

    // ---------- SELL ----------
    if (biasMode == "none" or bias < 0) and not doneS
        if actS
            if bar_index - startS > chochWait
                actS := false
            else if close < refLow and (open - close) >= dispATR * atr
                [zl, zh] = f_fvgBear(zoneLB)
                okFvg = not na(zl) and zh > zl
                if (requireFVG and okFvg) or (not requireFVG)
                    entry = okFvg ? zl + entryFrac * (zh - zl) : close
                    sl    = math.max(sweepHigh, okFvg ? zh : sweepHigh) + slBufATR * atr
                    R     = sl - entry
                    if R > 0 and entry > close and R >= minRATR * atr and R <= maxRATR * atr
                        doneS := true
                        actS  := false
                        nSet  += 1
                        sHavePend := true
                        sPE := entry
                        sPSL := sl
                        sPTP := f_tp(false, entry, R)
                        sPB := bar_index
                        sPX := bar_index + expireBars
                        alert("ICT SELL setup | Entry " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(f_tp(false, entry, R), format.mintick), alert.freq_once_per_bar_close)
        if not actS and not doneS
            if f_sweptHigh(need)
                actS      := true
                sweepHigh := high
                refLow    := lastSL
                startS    := bar_index

// ─────────────────────────  Vẽ mức nền  ─────────────────────────
plot(showAsia and asiaDone ? aHi : na, "Asia High", color=color.new(color.orange, 30), style=plot.style_stepline)
plot(showAsia and asiaDone ? aLo : na, "Asia Low",  color=color.new(color.orange, 30), style=plot.style_stepline)
plot(showPDPD ? pdh : na, "PDH", color=color.new(color.gray, 20), style=plot.style_stepline)
plot(showPDPD ? pdl : na, "PDL", color=color.new(color.gray, 20), style=plot.style_stepline)

// ─────────────────────────  Bảng thống kê  ─────────────────────────
var table statTbl = table.new(position.top_right, 2, 5, border_width=1)
if showStats and barstate.islast
    tot = nWin + nLoss + nBE
    wr = tot > 0 ? (nWin / tot * 100) : 0.0
    table.cell(statTbl, 0, 0, "Setup",   text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(statTbl, 1, 0, str.tostring(nSet), text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(statTbl, 0, 1, "WIN",     text_color=color.white, bgcolor=color.new(color.green, 40), text_size=size.small)
    table.cell(statTbl, 1, 1, str.tostring(nWin), text_color=color.white, bgcolor=color.new(color.green, 40), text_size=size.small)
    table.cell(statTbl, 0, 2, "LOSS",    text_color=color.white, bgcolor=color.new(color.red, 40), text_size=size.small)
    table.cell(statTbl, 1, 2, str.tostring(nLoss), text_color=color.white, bgcolor=color.new(color.red, 40), text_size=size.small)
    table.cell(statTbl, 0, 3, "Win%",    text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.cell(statTbl, 1, 3, str.tostring(wr, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.cell(statTbl, 0, 4, "Hòa",     text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(statTbl, 1, 4, str.tostring(nBE), text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
